NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://xxx:xxx@localhost:5432/xxx"
CORS_ORIGIN="http://localhost:5173"

JWT_ACCESS_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS=12


OPENROUTER_API_KEY="xxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_NAME="Notes Memory Graph"
OPENROUTER_SITE_URL="http://localhost:5000"

HUGGINGFACE_API_KEY="xxxxxxxxxxxxxxxx"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HUGGINGFACE_BASE_URL="https://router.huggingface.co/hf-inference"

MEMORY_GRAPH_SIMILARITY_THRESHOLD=0.72
MEMORY_GRAPH_MAX_CONNECTIONS=5