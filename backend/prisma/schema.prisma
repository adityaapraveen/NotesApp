generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes       Note[]
  sharedNotes NoteShare[]

  @@map("users")
}

model Note {
  id        String    @id @default(uuid())
  title     String
  content   String
  ownerId   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shares    NoteShare[]
  embedding NoteEmbedding?

  sourceConnections NoteConnection[] @relation("SourceNoteConnection")
  targetConnections NoteConnection[] @relation("TargetNoteConnection")

  @@index([ownerId])
  @@index([ownerId, deletedAt])
  @@map("notes")
}

model NoteShare {
  id               String   @id @default(uuid())
  noteId           String
  sharedWithUserId String
  createdAt        DateTime @default(now())

  note           Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedWithUser User @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([noteId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([noteId])
  @@map("note_shares")
}

model NoteEmbedding {
  id        String   @id @default(uuid())
  noteId    String   @unique
  model     String
  dimension Int
  vector    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_embeddings")
}

model NoteConnection {
  id           String   @id @default(uuid())
  sourceNoteId String
  targetNoteId String
  strength     Float
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceNote Note @relation("SourceNoteConnection", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("TargetNoteConnection", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@map("note_connections")
}